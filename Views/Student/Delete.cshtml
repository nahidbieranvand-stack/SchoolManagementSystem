    @model SchoolManagementSystem.ViewModels.Students.DeleteStudentViewModel
  
   <div class="card shadow mt-4">

    <div class="card-header bg-danger text-white">
        <h4 class="mb-0">
            <i class="bi bi-trash3-fill"></i>
            تایید حذف دانش‌آموز
        </h4>
    </div>

    <div class="card-body">
        <div class="alert alert-warning">

            <i class="bi bi-exclamation-triangle-fill"></i>

            آیا از حذف این دانش‌آموز مطمئن هستید؟

            <br />

            <small>

                این عملیات در نسخه فعلی باعث حذف اطلاعات می‌شود.

            </small>

        </div>
        <form asp-action="Delete" method="post">

            <input asp-for="Id" type="hidden" />
            <input type="hidden" name="page" value="@ViewBag.ReturnPage" />

            <div class="row">

                
                <!-- اطلاعات -->
                <div class="col-md-8">

                    <div class="card border-0 shadow-sm">

                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="bi bi-person-vcard"></i>
                                اطلاعات دانش‌آموز
                            </h5>
                        </div>

                        <div class="card-body">

                            <div class="row mb-3">
                                <div class="col-4 fw-bold">
                                    <i class="bi bi-person"></i>
                                    نام
                                </div>
                                <div class="col-8">
                                    @Model.FirstName
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-4 fw-bold">
                                    <i class="bi bi-people"></i>
                                    نام خانوادگی
                                </div>
                                <div class="col-8">
                                    @Model.LastName
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-4 fw-bold">
                                    <i class="bi bi-credit-card"></i>
                                    کد ملی
                                </div>
                                <div class="col-8">
                                    @Model.NationalCode.ToPersianNumber()
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-4 fw-bold">
                                    <i class="bi bi-calendar-date"></i>
                                    تاریخ تولد
                                </div>
                                <div class="col-8">
                                    @Model.BirthDate.ToShortDateString()
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-4 fw-bold">
                                    <i class="bi bi-person-heart"></i>
                                    نام پدر
                                </div>
                                <div class="col-8">
                                    @Model.FatherName
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-4 fw-bold">
                                    <i class="bi bi-telephone"></i>
                                    شماره تلفن
                                </div>
                                <div class="col-8">
                                    @Model.PhoneNumber.ToPersianNumber()
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-4 fw-bold">
                                    <i class="bi bi-gender-ambiguous"></i>
                                    جنسیت
                                </div>
                                <div class="col-8">
                                    @(Model.Gender == Gender.Male ? "مرد" : "زن")
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-4 fw-bold">
                                    <i class="bi bi-mortarboard"></i>
                                    پایه
                                </div>
                                <div class="col-8">
                                    @Model.Grade
                                </div>
                            </div>

                        </div>

                    </div>

                </div>
                <!-- عکس -->
                <div class="col-md-4 text-center mb-3">

                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath"
                             class="img-thumbnail shadow"
                             style="width:220px;height:260px;object-fit:cover;" />
                    }
                    else
                    {
                        <img src="~/images/students/default.png"
                             class="img-thumbnail shadow"
                             style="width:220px;height:260px;object-fit:cover;" />
                    }

                </div>


            </div>

            <hr />

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-right"></i>
                    انصراف

                </a>

                <button type="submit"
                        class="btn btn-danger">

                    <i class="bi bi-trash"></i>
                    حذف دانش‌آموز

                </button>

            </div>

        </form>
    
    </div></div>