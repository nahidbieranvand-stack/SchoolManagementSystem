    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "ایجاد دانش‌آموز";
}
@{
    @model SchoolManagementSystem.ViewModels.Students.CreateStudentViewModel
    <div class=" row mt-2"></div>
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow"> 
            <div class="card-header bg-primary text-white"> <h4> افزودن دانش آموز</h4></div>
     <div class="card-body">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <form asp-action="Create" method="post"
                          enctype="multipart/form-data">
           
                <div class="row">
                <div class="col-md-6 ">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control"  placeholder="نام"/>
                <span asp-validation-for="FirstName" class="text-danger"></span></div>



                 <div class="col-md-6 ">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" placeholder="نام خانوادگی" />
                <span asp-validation-for="LastName" class="text-danger"></span>
                </div></div>
           
    
                <div class="row">
                <div class="col-md-6">
                <label asp-for="NationalCode" class="form-label"></label>
                <input asp-for="NationalCode" class="form-control" placeholder="کدملی 10 رقمی "
                                       maxlength="10" minlwnght="10" pattern="[0-9]{10}"
                                       inputmode="numeric" />
                <span asp-validation-for="NationalCode" class="text-danger"></span>
            </div>
                <div class="col-md-6">
                <label asp-for="BirthDate" class="form-label"></label>
                <input asp-for="BirthDate" type="date" class="form-control" />
                <span asp-validation-for="BirthDate" class="text-danger"></span>
            </div></div>
                <div class="row">
                <div class="col-md-6">
                <label asp-for="FatherName" class="form-label"></label>
                <input asp-for="FatherName" class="form-control" />
                <span asp-validation-for="FatherName" class="text-danger"></span>
            </div>
                <div class="col-md-6">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div></div>

                 <div class="row">
                <div class="col-md-6">
                <label asp-for="Gender" class="form-label"></label>
                                <select asp-for="Gender"
                                        asp-items="Model.GenderList"
                                        class="form-select">
                                    <option value="">انتخاب کنید...</option>
                                </select>
            </div>
                <div class="col-md-6">
                <label asp-for="Grade" class="form-label"></label>
                                <label asp-for="Grade" class="form-label"></label>

                                <select asp-for="Grade"
                                        asp-items="Model.GradeList"
                                        class="form-select">
                                    <option value="">انتخاب پایه...</option>
                                </select>

                                <span asp-validation-for="Grade"
                                      class="text-danger"></span>
                    
            </div>
                            <div class="row">
                                <div class="col-md-6">

                                    <label asp-for="ImageFile" class="form-label">
                                        عکس دانش‌آموز
                                    </label>

                                    <input asp-for="ImageFile"
                                           type="file"
                                           class="form-control"
                                           accept="image/*" />

                                    <span asp-validation-for="ImageFile"
                                          class="text-danger">
                                    </span>

                                </div>
                            </div>

                <div class=" row mt-4"></div>
                <div class="row">
                <div class="col-md-6">
            <button class="btn btn-success" type="submit">
                افزودن
            </button>
            </div></div></div>
        </form>
     </div></div></div></div>
     
    
    
    }
