    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "تغییر اطلاعات دانش‌آموز";
}
@{
    @model SchoolManagementSystem.ViewModels.Students.EditStudentViewModel
    <h2> ویرایش دانش آموز</h2>
    
    <form asp-action="Edit"  method="post"
          enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger"></div>
        <input asp-for="Id" type="hidden" />
        <input asp-for="ImagePath" type="hidden" />
        <div class="row">
            <div class="col-md-6">
               
                <input type="hidden" name="page" value="@ViewBag.ReturnPage" />
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" />
                
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

            <div class="col-md-6">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div></div>

        <div class="row">
            <div class="col-md-6">
            <label asp-for="NationalCode" class="form-label"></label>
            <input asp-for="NationalCode" class="form-control" />
            <span asp-validation-for="NationalCode" class="text-danger"></span>
        </div>
            <div class="col-md-6">
            <label asp-for="BirthDate" class="form-label"></label>
            <input asp-for="BirthDate" type="date" class="form-control" />
            <span asp-validation-for="BirthDate" class="text-danger"></span>
            </div>
        </div>
            <div class="row">
                <div class="col-md-6">
            <label asp-for="FatherName" class="form-label"></label>
            <input asp-for="FatherName" class="form-control" />
            <span asp-validation-for="FatherName" class="text-danger"></span>
        </div>
            <div class="col-md-6">
            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber" class="form-control" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div></div>
                <div class="row">
                         
                <div class="col-md-6">
            <label asp-for="Gender" class="form-label"></label>
                <select asp-for="Gender"
                        asp-items="Model.GenderList"
                        class="form-select">
                    <option value="">انتخاب کنید...</option>
                </select>
      
       </div>
                <div class="col-md-6">
            <label asp-for="Grade" class="form-label"></label>
                <select asp-for="Grade"
                        asp-items="Model.GradeList"
                        class="form-select">
                    <option value="">انتخاب پایه...</option>
                </select>
        </div></div>  

       <div class="row">
                <div class="col-md-6">
            <label asp-for="ImagePath" class="form-label"> دانش آموز عکس</label>
               
            @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath"
                         alt="تصویر دانش‌آموز"
                         width="60"
                         height="60"
                         class="rounded"
                         style="object-fit:cover;" />
                }</div>
            <div class="col-md-6">
                
            <label asp-for="ImageFile" class="form-label mt-3">
                انتخاب عکس جدید
            </label>

            <input asp-for="ImageFile"
                   type="file"
                   class="form-control" />
                <span asp-validation-for="ImageFile"
                      class="text-danger">
                </span>
        </div></div>
        <div class="row">
            <div class="col-md-6"><td></td></div></div>
        <button class="btn btn-primary" type="submit" >
          تغییرات ذخیره شود
        </button>
        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-right"></i>

            انصراف

        </a>
    </form>
    
    }
