@using SchoolManagementSystem.Helpers
@*model List<SchoolManagementSystem.Models.Student>@**@
 @model  SchoolManagementSystem.ViewModels.Students.StudentListViewModel
 
@{
    ViewData["Title"] = "لیست دانش‌آموزان";
}  
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}


<div class="d-flex justify-content-between align-items-center mb-3 mt-3">
   <a class=" btn btn-success" asp-controller="Student"
      asp-action="Create">
            <i class="bi bi-plus-circle"></i> افزودن دانش آموز
        </a>
    <a asp-action="InactiveStudents"
       class="btn btn-secondary">

        <i class="bi bi-person-x"></i>

        دانش‌آموزان غیرفعال

    </a>
    <form asp-action="Index" method="get" class="search-box w-50">

        <div class="position-relative">

            <input type="text"
                   name="search"
                   value="@Context.Request.Query["search"]"
                   class="form-control rounded-pill ps-5"
                   placeholder="جستجو با نام،نام خانوادگی،کد ملی دانش آموز"
                   dir="rtl"
                   lang="fa" />

            <button type="submit"
                    class="btn position-absolute top-50 start-0 translate-middle-y border-0 bg-transparent">

                <i class="bi bi-search text-secondary fs-5"></i>

            </button>

        </div>

    </form>
    @*<form asp-action="Index" method="get">حالت سرچ اولیه که دکمهبورن
    <div class="input-group ">
    <input type="text" name="search" class="form-control" placeholder="نام،نام خانوادگی،کد ملی" />

    <button class="btn btn-primary" type="submit">
    <i class="bi bi-search"></i>
    جستجو
    </button>

    </div></form>*@
</div>
<div class=" row mt-3"></div>@* برای ایجاد فاصله بین دکهم و جدول*@
    <div class="card shadow" >
     <div class="card-header bg-primary text-white">
        <h4> لیست دانش آموزان</h4>
        </div>
        <div class="card-body ">
       
        <h3>SelectedId = @Model.SelectedId</h3>
            <table class="table  table-striped table-hover  table-bordered align-middle">
    <thead>
                <tr>
                    
            <th>ردیف</th>
                    <th>
                        <a asp-action="Index"
                           asp-route-sortOrder="@Model.NameSortParm"
                           
                           asp-route-search="@Context.Request.Query["search"]"
                           class="text-decoration-none text-dark">
                           
                            نام
                            @*<i class="bi bi-sort-alpha-down"></i>*@
                            @if (Model.NameSortParm == "name")
                            {
                                <span>▲</span>
                            }
                            else if (Model.NameSortParm == "name_desc")
                            {
                                <span>▼</span>
                            }
                        </a>
                    </th>
            <th>نام خانوادگی</th>
            <th>کد ملی</th>
            
            <th>نام پدر</th>
            <th>تلفن</th>
            <th>تاریخ تولد</th>
            
            <th>وضعیت</th>
            <th>تاریخ ثبت نام</th>
            <th>پایه </th>
            <th>جنسیت </th>
                 <th>عکس</th>
                    <th>عملیات</th>
        </tr>

    </thead>

    <tbody>
            @{
             //   int row = 1;
                    int row = ((Model.CurrentPage - 1) * Model.PageSize) + 1;//چون شمارنده صفحه بعد و قبل گذاشتیم باید مقدار rowبه این شکل باشد
            }




            @foreach (var student in Model.Students)
            {
                    <tr id="student-@student.Id" class="@(student.Id == Model.SelectedId ? "table-warning" : "")">
                    <td>@row</td>
                    <td>@student.FirstName</td>
                    <td>@student.LastName</td>
                        <td>@student.NationalCode.ToPersianNumber()</td>
                    <td>@student.FatherName</td>
                    <td>@student.PhoneNumber.ToPersianNumber()</td>
                        <td>@student.BirthDate.ToString("yyyy/MM/dd").ToPersianNumber()</td>
                   <td>
                            @if (student.IsActive)
                            {
                                <span class="badge bg-success">فعال</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">غیرفعال</span>
                            }
                   </td>
                        <td>@student.RegisterDate.ToString("yyyy/MM/dd").ToPersianNumber()</td>
                    <td>@student.Grade.Name</td>
                     <td>@student.Gender</td>
                        <td>
                       
                                @if (!string.IsNullOrEmpty(student.ImagePath))
                                {
                                <img src="@student.ImagePath"
                                     alt="تصویر دانش‌آموز"
                                     width="80"
                                     height="80"
                                     class="rounded"
                                     style="object-fit:cover;" />
                                }
                                else
                                {
                                <img src="/images/default-student.png"
                                     width="60"
                                     height="60"
                                     class="rounded" />
                                }
                        </td>
                     <td>
                        
                    <a asp-action="Edit"
                       asp-route-id="@student.Id"
                               sp-route-page="@Model.CurrentPage"
                       class="btn btn-outline-warning btn-sm me-1">
                                <i class="bi bi-pencil-square"></i>
                        ویرایش

                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@student.Id"
                               class="btn btn-outline-danger btn-sm ">
                                <i class="bi bi-trash"></i>
                        حذف
                    </a>
                    </td>
                </tr>
                    
                row++;
            }
                
        </tbody>
    </table>
        @{
            int startRecord = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
            int endRecord = startRecord + Model.Students.Count - 1;
            int currentPage = Model.CurrentPage;
            int totalPages = Model .TotalPages;
            int totalStudents =Model .TotalStudents;
        }
        <div class="d-flex justify-content-between align-items-center mt-3">

            <span class="text-muted">

                نمایش
                <strong>@startRecord.ToPersianNumber()</strong>

                تا

                <strong>@endRecord.ToPersianNumber()</strong>

                از

                <strong>@totalStudents.ToPersianNumber()</strong>

                دانش‌آموز

            </span>

            <span class="text-muted">

                صفحه

                <strong>@currentPage.ToPersianNumber()</strong>

                از

                <strong>@totalPages.ToPersianNumber()</strong>

            </span>

        </div>
        @if (Model.TotalPages > 1)
        {
               <nav class="mt-3">
                <ul class="pagination justify-content-center">

                    <!-- دکمه قبلی -->
                   <li class="page-item @(Model .CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-search="@Context.Request.Query["search"]"
                           asp-route-sortOrder="@Context.Request.Query["sortOrder"]">

                            <i class="bi bi-chevron-right"></i>

                        </a>
                    </li>
                    <!-- شماره صفحات -->
                    @for (int i = 1; i <= Model .TotalPages; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-search="@Context.Request.Query["search"]"
                               asp-route-sortOrder="@Context.Request.Query["sortOrder"]">

                                @i.ToPersianNumber()

                            </a>

                        </li>
                    }

                    <!-- دکمه بعدی -->
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-search="@Context.Request.Query["search"]"
                           asp-route-sortOrder="@Context.Request.Query["sortOrder"]">

                            <i class="bi bi-chevron-left"></i>

                        </a>

                    </li>

                </ul>

            </nav>

        }


        @section Scripts
        {
            <script>
                document.addEventListener("DOMContentLoaded", function () {

                    console.log("Script Started");

                    var selectedId = "@Model.SelectedId";

                    console.log("SelectedId:", selectedId);

                    var row = document.getElementById("student-" + selectedId);

                    console.log("Row:", row);

                    if (row) {
                        row.scrollIntoView({
                            behavior: "smooth",
                            block: "center"
                        });
                    }

                });
            </script>
        }
    </div>

     </div>
     