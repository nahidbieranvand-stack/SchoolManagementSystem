@{
    ViewData["Title"] = "لیست دانش‌آموزان";
}
    @model List<SchoolManagementSystem.Models.Student>

<div class="d-flex justify-content-between align-items-center mb-3 mt-3">
   <a class=" btn btn-success" asp-controller="Student"
      asp-action="Creat">
            <i class="bi bi-plus-circle"></i> افزودن دانش آموز
        </a>

    <form asp-action="Index" method="get">
            <div class="input-group ">
                <input type="text" name="search" class="form-control" placeholder="نام،نام خانوادگی،کد ملی" />
            
                <button class="btn btn-primary" type="submit">
                    <i class="bi bi-search"></i>
                    جستجو
                </button>
               
</div></form></div>
<div class=" row mt-3"></div>@* برای ایجاد فاصله بین دکهم و جدول*@
    <div class="card shadow" >
     <div class="card-header bg-primary text-white">
        <h4> لیست دانش آموزان</h4>
        </div>
        <div class="card-body ">
            <table class="table  table-striped table-hover  table-bordered align-middle">
    <thead>
        <tr>
            <th>ردیف</th>
                    <th>
                        <a asp-action="Index"
                           asp-route-sortOrder="@ViewBag.NameSortParm"
                           class="text-decoration-none text-dark">
                            نام
                            @*<i class="bi bi-sort-alpha-down"></i>*@
                            @if (ViewBag.NameSortParm == "name")
                            {
                                <span>▲</span>
                            }
                            else if (ViewBag.NameSortParm == "name_desc")
                            {
                                <span>▼</span>
                            }
                        </a>
                    </th>
            <th>نام خانوادگی</th>
            <th>کد ملی</th>
            
            <th>نام پدر</th>
            <th>تلفن</th>
            <th>تاریخ تولد</th>
            
            <th>وضعیت</th>
            <th>تاریخ ثبت نام</th>
            <th>پایه </th>
            <th>جنسیت </th>
                    <th>عملیات</th>
        </tr>

    </thead>

    <tbody>
            @{
                int row = 1;
            }




            @foreach (var student in Model)
            {
                <tr>
                    <td>@row</td>
                    <td>@student.FirstName</td>
                    <td>@student.LastName</td>
                    <td>@student.NationalCode</td>
                    <td>@student.FatherName</td>
                    <td>@student.PhoneNumber</td>
                    <td>@student.BirthDate.ToString()</td>
                   <td>
                            @if (student.IsActive)
                            {
                                <span class="badge bg-success">فعال</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">غیرفعال</span>
                            }
                   </td>
                    <td>@student.RegisterDate.ToString()</td>
                    <td>@student.Grade</td>
                     <td>@student.Gender</td>
                     <td>
                        
                    <a asp-action="Edit"
                       asp-route-id="@student.Id"
                       class="btn btn-outline-warning btn-sm me-1">
                                <i class="bi bi-pencil-square"></i>
                        ویرایش

                    </a>

                    <a asp-action="Delet"
                       asp-route-id="@student.Id"
                               class="btn btn-outline-danger btn-sm ">
                                <i class="bi bi-trash"></i>
                        حذف
                    </a>
                    </td>
                </tr>
                    
                row++;
            }

        </tbody>
    </table>
        </div>
    </div>

     