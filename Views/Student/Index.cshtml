@{
    ViewData["Title"] = "لیست دانش‌آموزان";
}
    @model List<SchoolManagementSystem.Models.Student>

<div class="d-flex justify-content-between align-items-center mb-3 mt-3">
   <a class=" btn btn-success" asp-controller="Student"
      asp-action="Creat">
            <i class="bi bi-plus-circle"></i> افزودن دانش آموز
        </a>

    <form asp-action="Index" method="get">
            <div class="input-group ">
                <input type="text" name="search" class="form-control" placeholder="نام،نام خانوادگی،کد ملی" />
            
                <button class="btn btn-primary" type="submit">
                    <i class="bi bi-search"></i>
                    جستجو
                </button>
               
</div></form></div>
<div class=" row mt-3"></div>@* برای ایجاد فاصله بین دکهم و جدول*@
    <div class="card shadow" >
     <div class="card-header bg-primary text-white">
        <h4> لیست دانش آموزان</h4>
        </div>
        <div class="card-body ">
            <table class="table  table-striped table-hover  table-bordered align-middle">
    <thead>
        <tr>
            <th>ردیف</th>
                    <th>
                        <a asp-action="Index"
                           asp-route-sortOrder="@ViewBag.NameSortParm"
                           class="text-decoration-none text-dark">
                            نام
                            @*<i class="bi bi-sort-alpha-down"></i>*@
                            @if (ViewBag.NameSortParm == "name")
                            {
                                <span>▲</span>
                            }
                            else if (ViewBag.NameSortParm == "name_desc")
                            {
                                <span>▼</span>
                            }
                        </a>
                    </th>
            <th>نام خانوادگی</th>
            <th>کد ملی</th>
            
            <th>نام پدر</th>
            <th>تلفن</th>
            <th>تاریخ تولد</th>
            
            <th>وضعیت</th>
            <th>تاریخ ثبت نام</th>
            <th>پایه </th>
            <th>جنسیت </th>
                    <th>عملیات</th>
        </tr>

    </thead>

    <tbody>
            @{
             //   int row = 1;
                    int row = ((ViewBag.CurrentPage - 1) * ViewBag.PageSize) + 1;//چون شمارنده صفحه بعد و قبل گذاشتیم باید مقدار rowبه این شکل باشد
            }




            @foreach (var student in Model)
            {
                <tr>
                    <td>@row</td>
                    <td>@student.FirstName</td>
                    <td>@student.LastName</td>
                    <td>@student.NationalCode</td>
                    <td>@student.FatherName</td>
                    <td>@student.PhoneNumber</td>
                    <td>@student.BirthDate.ToString()</td>
                   <td>
                            @if (student.IsActive)
                            {
                                <span class="badge bg-success">فعال</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">غیرفعال</span>
                            }
                   </td>
                    <td>@student.RegisterDate.ToString()</td>
                    <td>@student.Grade</td>
                     <td>@student.Gender</td>
                     <td>
                        
                    <a asp-action="Edit"
                       asp-route-id="@student.Id"
                       class="btn btn-outline-warning btn-sm me-1">
                                <i class="bi bi-pencil-square"></i>
                        ویرایش

                    </a>

                    <a asp-action="Delet"
                       asp-route-id="@student.Id"
                               class="btn btn-outline-danger btn-sm ">
                                <i class="bi bi-trash"></i>
                        حذف
                    </a>
                    </td>
                </tr>
                    
                row++;
            }
                
        </tbody>
    </table>
        @if (ViewBag.TotalPages > 1)
        {
               <nav class="mt-3">
                <ul class="pagination justify-content-center">

                    <!-- دکمه قبلی -->
                   <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                           asp-route-search="@Context.Request.Query["search"]"
                           asp-route-sortOrder="@Context.Request.Query["sortOrder"]">

                            <i class="bi bi-chevron-right"></i>

                        </a>
                    </li>
                    <!-- شماره صفحات -->
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-search="@Context.Request.Query["search"]"
                               asp-route-sortOrder="@Context.Request.Query["sortOrder"]">

                                @i

                            </a>

                        </li>
                    }

                    <!-- دکمه بعدی -->
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage + 1)"
                           asp-route-search="@Context.Request.Query["search"]"
                           asp-route-sortOrder="@Context.Request.Query["sortOrder"]">

                            <i class="bi bi-chevron-left"></i>

                        </a>

                    </li>

                </ul>
            </nav>
        }

         

            
    </div>

     